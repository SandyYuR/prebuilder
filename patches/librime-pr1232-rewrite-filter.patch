+class RewritePack::Impl {
+ public:
+  std::unique_ptr<RewriteMappedFile> file;
+  std::unordered_map<std::string_view, std::unique_ptr<RewriteSection>>
+      sections;
+};
+
+RewritePack::RewritePack(const path& file_path)
+    : file_path_(file_path), impl_(new Impl) {}
+
+RewritePack::~RewritePack() = default;
+
+bool RewritePack::Open() {
+  impl_->file = std::make_unique<RewriteMappedFile>(file_path_);
+  if (!impl_->file->Open()) {
+    LOG(ERROR) << "cannot open rewrite pack '" << file_path_
+               << "'; the file is missing, unreadable, or cannot be memory "
+                  "mapped. Redeploy the schema to rebuild it.";
+    return false;
+  }
+
+  const char* base = impl_->file->data();
+  const uint64_t file_size = impl_->file->file_size();
+  if (!base || file_size < kHeaderSize) {
+    LOG(ERROR) << "rewrite pack '" << file_path_
+               << "' is truncated or has no valid RWP header; redeploy the "
+                  "schema to rebuild this generated file.";
+    return false;
+  }
+  if (std::memcmp(base, kMagic, sizeof(kMagic)) != 0) {
+    if (std::memcmp(base, kMagic, sizeof(kMagic) - 1) == 0) {
+      LOG(ERROR) << "rewrite pack '" << file_path_ << "' uses incompatible "
+                 << "format marker '" << std::string_view(base, sizeof(kMagic))
+                 << "' (expected '" << std::string_view(kMagic, sizeof(kMagic))
+                 << "'); redeploy the schema to rebuild the pack.";
+    } else {
+      LOG(ERROR) << "rewrite pack '" << file_path_
+                 << "' has an invalid RWP header; redeploy the schema to "
+                    "rebuild this generated file.";
+    }
+    return false;
+  }
+
+  const uint32_t version = ReadU32(base + 8);
+  if (version != kFormatVersion) {
+    LOG(ERROR) << "rewrite pack '" << file_path_ << "' uses format version "
+               << version << ", but this build expects version "
+               << kFormatVersion
+               << "; redeploy the schema to rebuild the pack.";
+    return false;
+  }
+
+  const uint32_t section_count = ReadU32(base + 12);
+  const uint64_t section_table_offset = ReadU64(base + 16);
+  build_id_ = ReadU64(base + 24);
+  const uint64_t source_checksum = ReadU64(base + 32);
+  (void)source_checksum;
+  const uint64_t declared_file_size = ReadU64(base + 40);
+  if (declared_file_size != file_size ||
+      !ValidateSectionTable(section_count, section_table_offset, file_size)) {
+    LOG(ERROR) << "rewrite pack '" << file_path_
+               << "' has a corrupted section directory; redeploy the schema "
+                  "to rebuild the pack.";
+    return false;
+  }
+
+  impl_->sections.clear();
+  impl_->sections.reserve(section_count);
+
+  for (uint32_t i = 0; i < section_count; ++i) {
+    const char* p = base + section_table_offset + i * kSectionRecordSize;
+    const SectionRecord section_record = ReadSectionRecord(p);
+    if (!ValidateSectionRecord(section_record, file_size)) {
+      LOG(ERROR) << "rewrite pack '" << file_path_
+                 << "' contains an invalid section entry; redeploy the schema "
+                    "to rebuild the pack.";
+      return false;
+    }
+
+    const std::string_view name(base + section_record.name_offset,
+                                section_record.name_size);
+    if (impl_->sections.find(name) != impl_->sections.end()) {
+      LOG(ERROR) << "rewrite pack '" << file_path_
+                 << "' contains duplicate section '" << name
+                 << "'; redeploy the schema to rebuild the pack.";
+      return false;
+    }
+
+    auto section = std::unique_ptr<RewriteSection>(new RewriteSection);
+    const char* sp = base + section_record.stage_table_offset;
+    const StageRecord stage_record = ReadStageRecord(sp);
+    const bool has_phrase_trie = stage_record.phrase_key_count != 0;
+    if (!ValidateStageRecord(stage_record, file_size)) {
+      LOG(ERROR) << "rewrite pack '" << file_path_ << "' has corrupted "
+                 << "stage metadata in section '" << name
+                 << "'; redeploy the schema to rebuild the pack.";
+      return false;
+    }
+
+    StageView& stage = section->impl_->stage;
+    stage.char_directory = reinterpret_cast<const uint16_t*>(
+        base + stage_record.char_directory_offset);
+    stage.char_pages = reinterpret_cast<const uint32_t*>(
+        base + stage_record.char_pages_offset);
+    stage.char_page_count = stage_record.char_page_count;
+    stage.key_index = base + stage_record.key_index_offset;
+    stage.value_pool = base + stage_record.value_pool_offset;
+    stage.value_pool_end = stage.value_pool + stage_record.value_pool_size;
+    stage.key_count = stage_record.key_count;
+    stage.phrase_key_count = stage_record.phrase_key_count;
+    stage.flags = stage_record.flags;
+
+    if (has_phrase_trie) {
+      stage.phrase_trie.set_array(
+          base + stage_record.phrase_trie_offset,
+          static_cast<size_t>(stage_record.phrase_trie_size /
+                              stage.phrase_trie.unit_size()));
+    }
+
+    impl_->sections.emplace(name, std::move(section));
+  }
+  return true;
+}
+
+std::shared_ptr<RewritePack> RewritePack::OpenCached(const path& file_path) {
+  static std::mutex mutex;
+  static std::unordered_map<string, std::weak_ptr<RewritePack>> cache;
+
+  const string cache_key = file_path.u8string();
+  uint64_t on_disk_build_id = 0;
+  const bool has_build_id = ReadPackBuildId(file_path, &on_disk_build_id);
+
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found = cache.find(cache_key);
+    if (found != cache.end()) {
+      if (auto cached = found->second.lock()) {
+        if (has_build_id && cached->build_id() == on_disk_build_id) {
+          return cached;
+        }
+      }
+      cache.erase(found);
+    }
+  }
+
+  auto pack = std::shared_ptr<RewritePack>(new RewritePack(file_path));
+  if (!pack->Open()) {
+    return nullptr;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found = cache.find(cache_key);
+    if (found != cache.end()) {
+      if (auto cached = found->second.lock()) {
+        if (cached->build_id() == pack->build_id()) {
+          return cached;
+        }
+      }
+    }
+    cache[cache_key] = pack;
+  }
+  return pack;
+}
+
+RewritePack::StageHandle RewritePack::FindSection(const string& name) const {
+  const std::string_view wanted(name.data(), name.size());
+  const auto& sections = impl_->sections;
+  const auto found = sections.find(wanted);
+  return found == sections.end() ? nullptr : found->second.get();
+}
+
+namespace {
+
+bool BuildRewritePackInternal(const path& output_path,
+                              const vector<RewriteSectionData>& sections,
+                              uint64_t source_checksum) {
+  if (sections.empty() || !FitsU32(sections.size())) {
+    LOG(ERROR) << "cannot build rewrite pack: section list is empty or exceeds "
+                  "the RWP format limit.";
+    return false;
+  }
+
+  std::unordered_set<string> section_names;
+  section_names.reserve(sections.size());
+  for (const auto& section : sections) {
+    if (section.name.empty() || !FitsU32(section.name.size()) ||
+        section.stage.entries.empty() ||
+        !section_names.insert(section.name).second) {
+      LOG(ERROR) << "cannot build rewrite section '" << section.name
+                 << "': section name is empty, duplicated, too long, or the "
+                    "section contains no usable entries.";
+      return false;
+    }
+  }
+
+  const uint64_t build_id = ComputeBuildId(sections);
+
+  std::error_code ec;
+  const path parent_path = output_path.parent_path();
+  if (!parent_path.empty()) {
+    std::filesystem::create_directories(parent_path, ec);
+    if (ec) {
+      LOG(ERROR) << "cannot create rewrite pack directory '" << parent_path
+                 << "': " << ec.message()
+                 << "; check directory permissions and available storage.";
+      return false;
+    }
+  }
+
+  const path temporary_path = MakeTemporaryPath(output_path);
+  TemporaryFileGuard temporary_file(temporary_path);
+  std::ofstream out(static_cast<const std::filesystem::path&>(temporary_path),
+                    std::ios::binary | std::ios::trunc);
+  if (!out) {
+    LOG(ERROR) << "cannot create temporary rewrite pack '" << temporary_path
+               << "'; check directory permissions and available storage.";
+    return false;
+  }
+
+  out.write(kMagic, sizeof(kMagic));
+  WriteU32(&out, kFormatVersion);
+  WriteU32(&out, static_cast<uint32_t>(sections.size()));
+  WriteU64(&out, kHeaderSize);
+  WriteU64(&out, build_id);
+  WriteU64(&out, source_checksum);
+  WriteU64(&out, 0);
+
+  const uint64_t section_table_offset = Tell(&out);
+  WriteZeros(&out, sections.size() * kSectionRecordSize);
+  vector<SectionRecord> section_records(sections.size());
+
+  for (size_t section_index = 0; section_index < sections.size();
+       ++section_index) {
+    const auto& source_section = sections[section_index];
+    auto& section_record = section_records[section_index];
+
+    section_record.name_offset = Tell(&out);
+    section_record.name_size =
+        static_cast<uint32_t>(source_section.name.size());
+    out.write(source_section.name.data(), source_section.name.size());
+
+    section_record.stage_count = 1;
+    section_record.stage_table_offset = Tell(&out);
+    WriteZeros(&out, kStageRecordSize);
+    StageRecord stage_record;
+    const auto& source_stage = source_section.stage;
+    const bool has_preedit =
+        std::any_of(source_stage.entries.begin(), source_stage.entries.end(),
+                    [](const auto& entry) { return !entry.preedit.empty(); });
+    if (has_preedit) {
+      stage_record.flags |= kStageFlagHasPreedit;
+    }
+
+    // Views point into immutable source_stage.entries, avoiding a second
+    // copy of every key/value while compiling. A tiny linear scan dedups
+    // values per key; real rewrite dictionaries overwhelmingly have one
+    // value per key, so this is cheaper than an unordered_set per bucket.
+    struct StoredValue {
+      std::string_view value;
+      std::string_view preedit;
+    };
+    struct Bucket {
+      std::string_view key;
+      vector<StoredValue> values;
+    };
+
+    vector<Bucket> buckets;
+    std::unordered_map<std::string_view, size_t> key_to_bucket;
+    buckets.reserve(source_stage.entries.size());
+    key_to_bucket.reserve(source_stage.entries.size());
+
+    for (const auto& entry : source_stage.entries) {
+      if (entry.key.empty() || entry.value.empty()) {
+        continue;
+      }
+
+      const std::string_view key(entry.key.data(), entry.key.size());
+      const std::string_view value(entry.value.data(), entry.value.size());
+      const std::string_view preedit(entry.preedit.data(),
+                                     entry.preedit.size());
+      auto found = key_to_bucket.find(key);
+      size_t bucket_index = 0;
+      if (found == key_to_bucket.end()) {
+        bucket_index = buckets.size();
+        key_to_bucket.emplace(key, bucket_index);
+        buckets.push_back(Bucket{key, {}});
+      } else {
+        bucket_index = found->second;
+      }
+
+      auto& values = buckets[bucket_index].values;
+      const auto duplicate =
+          std::find_if(values.begin(), values.end(),
+                       [&](const auto& item) { return item.value == value; });
+      if (duplicate == values.end()) {
+        values.push_back({value, preedit});
+      }
+    }
+
+    if (buckets.empty() || !FitsU32(buckets.size())) {
+      LOG(ERROR) << "cannot build rewrite section '" << source_section.name
+                 << "': no usable keys remain or the key count exceeds the "
+                    "RWP format limit.";
+      return false;
+    }
+
+    if (buckets.size() > kDispatchKeyMask) {
+      LOG(ERROR) << "cannot build rewrite section '" << source_section.name
+                 << "': key count exceeds the RWP5 direct-dispatch limit.";
+      return false;
+    }
+
+    std::array<uint16_t, kCharDirectoryEntries> char_directory{};
+    vector<std::array<uint32_t, kCharPageSize>> char_pages;
+    vector<size_t> phrase_bucket_ids;
+    phrase_bucket_ids.reserve(buckets.size());
+
+    auto ensure_dispatch_page =
+        [&](uint32_t code_point) -> std::array<uint32_t, kCharPageSize>& {
+      uint16_t& page_id = char_directory[code_point >> kCharPageShift];
+      if (page_id == 0) {
+        char_pages.emplace_back();
+        page_id = static_cast<uint16_t>(char_pages.size());
+      }
+      return char_pages[page_id - 1];
+    };
+
+    for (size_t key_id = 0; key_id < buckets.size(); ++key_id) {
+      const auto& bucket = buckets[key_id];
+      if (bucket.key.find('\0') != std::string_view::npos) {
+        LOG(ERROR) << "cannot build rewrite section '" << source_section.name
+                   << "': rewrite keys containing NUL bytes are unsupported.";
+        return false;
+      }
+
+      uint32_t first_code_point = 0;
+      size_t first_char_size = 0;
+      if (!ValidateUtf8Key(bucket.key, &first_code_point, &first_char_size)) {
+        LOG(ERROR) << "cannot build rewrite section '" << source_section.name
+                   << "': rewrite key contains invalid UTF-8.";
+        return false;
+      }
+
+      auto& page = ensure_dispatch_page(first_code_point);
+      uint32_t& dispatch = page[first_code_point & kCharPageMask];
+      const uint32_t encoded_key_id = static_cast<uint32_t>(key_id + 1);
+
+      if (first_char_size == bucket.key.size()) {
+        if ((dispatch & kDispatchKeyMask) != 0) {
+          LOG(ERROR) << "internal duplicate single-character key in section '"
+                     << source_section.name << "'.";
+          return false;
+        }
+        dispatch |= encoded_key_id;
+      } else {
+        dispatch |= kDispatchPhraseStarter;
+        phrase_bucket_ids.push_back(key_id);
+      }
+    }
+
+    if (char_pages.empty() ||
+        char_pages.size() > std::numeric_limits<uint16_t>::max()) {
+      LOG(ERROR) << "cannot build rewrite section '" << source_section.name
+                 << "': character dispatch table exceeds the RWP5 limit.";
+      return false;
+    }
+
+    const auto byte_less = [&](size_t lhs_id, size_t rhs_id) {
+      const std::string_view lhs = buckets[lhs_id].key;
+      const std::string_view rhs = buckets[rhs_id].key;
+      return std::lexicographical_compare(
+          lhs.begin(), lhs.end(), rhs.begin(), rhs.end(),
+          [](char lhs_char, char rhs_char) {
+            return static_cast<unsigned char>(lhs_char) <
+                   static_cast<unsigned char>(rhs_char);
+          });
+    };
+    std::sort(phrase_bucket_ids.begin(), phrase_bucket_ids.end(), byte_less);
+
+    vector<const char*> phrase_keys;
+    vector<size_t> phrase_lengths;
+    vector<int> phrase_values;
+    phrase_keys.reserve(phrase_bucket_ids.size());
+    phrase_lengths.reserve(phrase_bucket_ids.size());
+    phrase_values.reserve(phrase_bucket_ids.size());
+    for (const size_t key_id : phrase_bucket_ids) {
+      phrase_keys.push_back(buckets[key_id].key.data());
+      phrase_lengths.push_back(buckets[key_id].key.size());
+      phrase_values.push_back(static_cast<int>(key_id + 1));
+    }
+
+    Darts::DoubleArray phrase_trie;
+    if (!phrase_keys.empty()) {
+      try {
+        LOG(INFO) << "building rewrite phrase trie '" << source_section.name
+                  << "' with " << phrase_keys.size() << " phrase keys and "
+                  << (buckets.size() - phrase_keys.size())
+                  << " direct single-character keys.";
+        phrase_trie.build(phrase_keys.size(), phrase_keys.data(),
+                          phrase_lengths.data(), phrase_values.data());
+      } catch (const std::exception& ex) {
+        LOG(ERROR) << "cannot build rewrite phrase trie for section '"
+                   << source_section.name << "': " << ex.what()
+                   << "; check source size/content or available memory.";
+        return false;
+      } catch (...) {
+        LOG(ERROR) << "cannot build rewrite phrase trie for section '"
+                   << source_section.name
+                   << "' due to an unknown error; the pack was not installed.";
+        return false;
+      }
+      if (phrase_trie.total_size() == 0 ||
+          (phrase_trie.total_size() % phrase_trie.unit_size()) != 0) {
+        LOG(ERROR) << "internal rewrite phrase-trie size mismatch in section '"
+                   << source_section.name << "'; the pack was not installed.";
+        return false;
+      }
+    }
+
+    Align(&out, alignof(uint32_t));
+    stage_record.char_directory_offset = Tell(&out);
+    out.write(reinterpret_cast<const char*>(char_directory.data()),
+              static_cast<std::streamsize>(sizeof(char_directory)));
+    stage_record.char_pages_offset = Tell(&out);
+    for (const auto& page : char_pages) {
+      out.write(reinterpret_cast<const char*>(page.data()),
+                static_cast<std::streamsize>(sizeof(page)));
+    }
+    stage_record.char_page_count = static_cast<uint32_t>(char_pages.size());
+    if (!out) {
+      LOG(ERROR) << "cannot serialize rewrite dispatch table for section '"
+                 << source_section.name
+                 << "'; check available storage and filesystem health.";
+      return false;
+    }
+
+    stage_record.phrase_key_count = static_cast<uint32_t>(phrase_keys.size());
+    if (!phrase_keys.empty()) {
+      Align(&out, alignof(uint32_t));
+      stage_record.phrase_trie_offset = Tell(&out);
+      stage_record.phrase_trie_size = phrase_trie.total_size();
+      out.write(reinterpret_cast<const char*>(phrase_trie.array()),
+                static_cast<std::streamsize>(phrase_trie.total_size()));
+      if (!out || Tell(&out) != stage_record.phrase_trie_offset +
+                                    stage_record.phrase_trie_size) {
+        LOG(ERROR) << "cannot serialize rewrite phrase trie for section '"
+                   << source_section.name
+                   << "'; check available storage and filesystem health.";
+        return false;
+      }
+    }
+
+    stage_record.key_index_offset = Tell(&out);
+    stage_record.key_count = static_cast<uint32_t>(buckets.size());
+
+    uint64_t value_pool_size = 0;
+    for (const auto& bucket : buckets) {
+      const auto& values = bucket.values;
+      if (values.empty() || !FitsU32(values.size()) ||
+          value_pool_size > std::numeric_limits<uint32_t>::max()) {
+        LOG(ERROR) << "rewrite value list in section '" << source_section.name
+                   << "' is empty or exceeds the RWP format limit; reduce "
+                      "values for a single key or split the source.";
+        return false;
+      }
+
+      WriteU32(&out, static_cast<uint32_t>(value_pool_size));
+      WriteU32(&out, static_cast<uint32_t>(values.size()));
+
+      for (const auto& item : values) {
+        if (!FitsU32(item.preedit.size()) || !FitsU32(item.value.size())) {
+          LOG(ERROR) << "rewrite value or stored preedit in section '"
+                     << source_section.name
+                     << "' exceeds the RWP format limit.";
+          return false;
+        }
+        uint64_t encoded_size = 0;
+        if (has_preedit) {
+          encoded_size +=
+              VarUint32Size(static_cast<uint32_t>(item.preedit.size())) +
+              static_cast<uint64_t>(item.preedit.size());
+        }
+        encoded_size +=
+            VarUint32Size(static_cast<uint32_t>(item.value.size())) +
+            static_cast<uint64_t>(item.value.size());
+        if (encoded_size >
+            std::numeric_limits<uint32_t>::max() - value_pool_size) {
+          LOG(ERROR) << "rewrite value pool in section '" << source_section.name
+                     << "' exceeds the 4 GiB RWP format limit; split the "
+                        "rewrite data into smaller sections.";
+          return false;
+        }
+        value_pool_size += encoded_size;
+      }
+    }
+
+    stage_record.value_pool_offset = Tell(&out);
+    stage_record.value_pool_size = value_pool_size;
+    for (const auto& bucket : buckets) {
+      for (const auto& item : bucket.values) {
+        if (has_preedit) {
+          WriteVarUint32(&out, static_cast<uint32_t>(item.preedit.size()));
+          out.write(item.preedit.data(), item.preedit.size());
+        }
+        WriteVarUint32(&out, static_cast<uint32_t>(item.value.size()));
+        out.write(item.value.data(), item.value.size());
+      }
+    }
+    if (!out || Tell(&out) != stage_record.value_pool_offset +
+                                  stage_record.value_pool_size) {
+      LOG(ERROR) << "internal rewrite value-pool size mismatch in section '"
+                 << source_section.name << "'; the pack was not installed.";
+      return false;
+    }
+
+    const uint64_t return_pos = Tell(&out);
+    out.seekp(section_record.stage_table_offset);
+    if (!out) {
+      LOG(ERROR) << "failed to write rewrite stage table for section '"
+                 << source_section.name
+                 << "'; check available storage and filesystem health.";
+      return false;
+    }
+    WriteStageRecord(&out, stage_record);
+    out.seekp(return_pos);
+    if (!out) {
+      LOG(ERROR) << "failed to continue writing rewrite section '"
+                 << source_section.name
+                 << "'; check available storage and filesystem health.";
+      return false;
+    }
+  }
+
+  const uint64_t file_size = Tell(&out);
+  out.seekp(section_table_offset);
+  if (!out) {
+    LOG(ERROR) << "failed to finalize rewrite section table for '"
+               << output_path
+               << "'; check available storage and filesystem health.";
+    return false;
+  }
+  for (const auto& section_record : section_records) {
+    WriteSectionRecord(&out, section_record);
+  }
+  out.seekp(40);
+  if (!out) {
+    LOG(ERROR) << "failed to finalize rewrite pack header for '" << output_path
+               << "'; check available storage and filesystem health.";
+    return false;
+  }
+  WriteU64(&out, file_size);
+  out.close();
+
+  if (!out) {
+    LOG(ERROR) << "failed to finish writing temporary rewrite pack '"
+               << temporary_path
+               << "'; check available storage and filesystem health.";
+    return false;
+  }
+
+  // Rename within the same directory is atomic on POSIX. On Windows the
+  // platform replacement API is used without deleting the old file first;
+  // if a live mapping prevents replacement, deployment fails and the old
+  // pack remains available.
+  if (!InstallAtomically(temporary_path, output_path, &ec)) {
+    LOG(ERROR) << "cannot install rewrite pack '" << output_path
+               << "': " << ec.message()
+               << "; the previous pack was left unchanged. Check file "
+                  "permissions and whether another process is holding the "
+                  "file.";
+    return false;
+  }
+  temporary_file.Commit();
+  return true;
+}
+
+}  // namespace
+
+bool RewritePackBuilder::IsUpToDate(const path& file_path,
+                                    uint64_t source_checksum) {
+  std::ifstream in(static_cast<const std::filesystem::path&>(file_path),
+                   std::ios::binary);
+  if (!in) {
+    return false;
+  }
+
+  std::array<char, kHeaderSize> header{};
+  in.read(header.data(), header.size());
+  if (in.gcount() != static_cast<std::streamsize>(header.size()) ||
+      std::memcmp(header.data(), kMagic, sizeof(kMagic)) != 0 ||
+      ReadU32(header.data() + 8) != kFormatVersion ||
+      ReadU64(header.data() + 32) != source_checksum) {
+    return false;
+  }
+
+  std::error_code ec;
+  const uint64_t actual_size = std::filesystem::file_size(file_path, ec);
+  if (ec || actual_size < kHeaderSize ||
+      ReadU64(header.data() + 40) != actual_size) {
+    return false;
+  }
+
+  const uint32_t section_count = ReadU32(header.data() + 12);
+  const uint64_t section_table_offset = ReadU64(header.data() + 16);
+  if (!ValidateSectionTable(section_count, section_table_offset, actual_size)) {
+    return false;
+  }
+
+  std::unordered_set<string> section_names;
+  section_names.reserve(section_count);
+  for (uint32_t i = 0; i < section_count; ++i) {
+    std::array<char, kSectionRecordSize> section_bytes{};
+    in.seekg(static_cast<std::streamoff>(
+        section_table_offset + static_cast<uint64_t>(i) * kSectionRecordSize));
+    in.read(section_bytes.data(), section_bytes.size());
+    if (!in) {
+      return false;
+    }
+
+    const SectionRecord section_record =
+        ReadSectionRecord(section_bytes.data());
+    if (!ValidateSectionRecord(section_record, actual_size)) {
+      return false;
+    }
+
+    string name(section_record.name_size, '\0');
+    in.seekg(static_cast<std::streamoff>(section_record.name_offset));
+    in.read(name.data(), static_cast<std::streamsize>(name.size()));
+    if (!in || !section_names.insert(name).second) {
+      return false;
+    }
+
+    std::array<char, kStageRecordSize> stage_bytes{};
+    in.seekg(static_cast<std::streamoff>(section_record.stage_table_offset));
+    in.read(stage_bytes.data(), stage_bytes.size());
+    if (!in) {
+      return false;
+    }
+
+    const StageRecord stage_record = ReadStageRecord(stage_bytes.data());
+    if (!ValidateStageRecord(stage_record, actual_size)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool RewritePackBuilder::Build(const path& output_path,
+                               const vector<RewriteSectionData>& sections,
+                               uint64_t source_checksum) const {
+  return BuildRewritePackInternal(output_path, sections, source_checksum);
+}
+
+bool RewritePackBuilder::Build(
+    const path& output_path,
+    const vector<RewriteSectionData>& sections) const {
+  return BuildRewritePackInternal(output_path, sections, 0);
+}
+
