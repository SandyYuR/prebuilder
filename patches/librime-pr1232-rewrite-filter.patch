+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <rime/common.h>
+
+namespace rime {
+
+struct RewritePresetStage {
+  string name;
+  vector<path> files;
+};
+
+class RewritePresetCatalog {
+ public:
+  explicit RewritePresetCatalog(const path& root_path);
+  ~RewritePresetCatalog();
+
+  bool Load();
