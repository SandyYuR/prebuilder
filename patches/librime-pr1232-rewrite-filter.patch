+path ResolveStorePath() {
+  the<ResourceResolver> resolver(
+      Service::instance().CreateDeployedResourceResolver(
+          {"rewrite_pack", "", ".rwp"}));
+  return resolver ? resolver->ResolvePath("rewriter") : path();
+}
